# ============================================================
# Environmental Forensic Intelligence — Environment Variables
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-random-secret-key-in-production
APP_DEBUG=true
DEMO_MODE=true

# ── Database ─────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=efi_db
POSTGRES_USER=efi_user
POSTGRES_PASSWORD=efi_password
DATABASE_URL=postgresql+asyncpg://efi_user:efi_password@db:5432/efi_db

# ── Redis (Job Queue + Cache) ─────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Object Storage (local filesystem — S3-ready) ─────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/data
# For future S3 support:
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=

# ── Copernicus Data Space (Sentinel-2 / Sentinel-1) ──────────
# Register free at: https://dataspace.copernicus.eu
# Leave blank to use DEMO_MODE=true
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1

# ── Frontend ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAPTILER_KEY=
# MapLibre works without a key for OpenStreetMap raster tiles.
# For vector tiles, get a free key at https://maptiler.com

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Workers ──────────────────────────────────────────────────
WORKER_CONCURRENCY=2
JOB_MAX_RETRIES=3
JOB_RETRY_DELAY_SECONDS=60

# ── Preprocessing ─────────────────────────────────────────────
PREPROCESSING_VERSION=v1.0.0
DEFAULT_CLOUD_THRESHOLD=60
DEFAULT_MIN_VALID_PIXELS=40

# ── Risk Engine ───────────────────────────────────────────────
RISK_CONFIG_PATH=/app/configs/risk_weights.json

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
